# Copy to .env and edit. Never commit a real .env file.
# Leave SECRET_KEY empty to auto-generate a random key into instance/secret.key
SECRET_KEY=
DATABASE_PATH=database/voting.db
HOST=127.0.0.1
PORT=5000
DEBUG=True
# Optional tuning
RATE_LIMIT_SENSITIVE=20
RATE_LIMIT_GENERAL=300
RATE_LIMIT_WINDOW=60
HASH_ITERATIONS=200000
